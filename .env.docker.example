# =============================================================================
# GST CRM Backend - Docker Environment Configuration Template
# Copy this file to .env and adjust values for your server
# =============================================================================

# Server Port & Environment
PORT=3002
NODE_ENV=production

# Frontend URL (Used for CORS and Cookie settings)
FRONTEND_URL=https://gst.aarsanjewels.cloud

# Database Docker Configuration
DB_USER=gstcrm_user
DB_PASSWORD=CHANGE_THIS_TO_A_VERY_SECURE_PASSWORD
DB_NAME=gstcrm_db
DB_PORT=5433

# ─────────────────────────────────────────────────────────────────────────────
# Database Connection URL:
# 
# Option A: If backend runs inside DOCKER container (gstcrm-server):
DATABASE_URL=postgresql://gstcrm_user:CHANGE_THIS_TO_A_VERY_SECURE_PASSWORD@gstcrm-postgres:5432/gstcrm_db?sslmode=disable
#
# Option B: If backend runs on HOST directly:
# DATABASE_URL=postgresql://gstcrm_user:CHANGE_THIS_TO_A_VERY_SECURE_PASSWORD@127.0.0.1:5433/gstcrm_db?sslmode=disable
# ─────────────────────────────────────────────────────────────────────────────

# JWT & Authentication Secrets (must be >= 32 characters)
JWT_SECRET=replace_with_a_random_32_character_string_minimum_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_another_32_character_string_minimum_here
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Security & Backup
BCRYPT_ROUNDS=12
BACKUP_ENCRYPTION_PASSWORD=replace_with_secure_backup_encryption_pass

# Logs (Settings › Logs) — all optional
# Login history / activity / audit rows older than this are deleted daily (DB keeps >= 300 days).
LOG_RETENTION_DAYS=365
# Bill & Data History (data_audit_log) — 8 years by default (DB keeps >= 8 years).
DATA_AUDIT_RETENTION_DAYS=2922
# HMAC key for the audit hash chain: 64 hex chars (openssl rand -hex 32). Set before go-live;
# changing it later makes older rows fail verification. Empty = un-keyed SHA-256 + warning.
AUDIT_CHAIN_KEY=
# MaxMind GeoLite2-City.mmdb for login locations (missing file = no city/country).
GEOIP_DB_PATH=./geoip/GeoLite2-City.mmdb
